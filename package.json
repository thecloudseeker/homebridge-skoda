{
  "name": "@thecloudseeker/homebridge-skoda",
  "displayName": "Homebridge Škoda",
  "version": "0.1.0",
  "description": "Homebridge plugin for Škoda vehicles using the official MyŠkoda Public API.",
  "author": "thecloudseeker",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/thecloudseeker/homebridge-skoda#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecloudseeker/homebridge-skoda.git"
  },
  "bugs": {
    "url": "https://github.com/thecloudseeker/homebridge-skoda/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "skoda",
    "myskoda",
    "enyaq",
    "elroq",
    "ev",
    "homekit"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.2.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
