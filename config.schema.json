{
  "pluginAlias": "Skoda",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "headerDisplay": "Connects Škoda vehicles through the official **MyŠkoda Public API**. Create an API key in the MyŠkoda app under *Profile › Smart Home* (or open [go.skoda.eu/api-keys](https://go.skoda.eu/api-keys) on your phone). The API allows **20 requests per hour per vehicle**, so data is polled every few minutes and commands take a moment to show up. This is not an official Škoda project.",
  "footerDisplay": "See the [README](https://github.com/thecloudseeker/homebridge-skoda#readme) for details on each feature.",
  "schema": {
    "type": "object",
    "properties": {
      "vehicles": {
        "title": "Vehicles",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "placeholder": "Enyaq",
              "description": "Name of the accessory in HomeKit."
            },
            "vin": {
              "title": "VIN",
              "type": "string",
              "required": true,
              "minLength": 17,
              "maxLength": 17,
              "pattern": "^[A-HJ-NPR-Za-hj-npr-z0-9]{17}$",
              "description": "17-character vehicle identification number."
            },
            "token": {
              "title": "API key",
              "type": "string",
              "required": true,
              "description": "API key from the MyŠkoda app (Profile › Smart Home). Used for reading the vehicle and for commands."
            },
            "spin": {
              "title": "S-PIN (optional)",
              "type": "string",
              "description": "Security PIN of your MyŠkoda account. Only needed to start the auxiliary heating; it is sent with each start and never logged."
            },
            "home": {
              "title": "Home location",
              "type": "object",
              "properties": {
                "lat": {
                  "title": "Latitude",
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "title": "Longitude",
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "radiusMeters": {
                  "title": "Radius (m)",
                  "type": "integer",
                  "minimum": 10,
                  "placeholder": 150
                }
              }
            },
            "pollingIntervalMinutes": {
              "title": "Update interval (minutes)",
              "type": "integer",
              "minimum": 4,
              "maximum": 1440,
              "placeholder": 5,
              "description": "How often the plugin fetches the vehicle's state. At least 4, default 5: the API allows 20 requests per hour, and 4 are kept free for commands."
            },
            "lowBatteryThreshold": {
              "title": "Low battery / fuel warning below (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "placeholder": 20,
              "description": "HomeKit shows low battery when the battery or fuel level drops below this value. Default 20."
            },
            "climateTemperature": {
              "title": "Default temperature (°C)",
              "type": "number",
              "minimum": 16,
              "maximum": 29.5,
              "multipleOf": 0.5,
              "placeholder": 21,
              "description": "Used for the first start until the vehicle reports its own target temperature. 16-29.5 in steps of 0.5, default 21."
            },
            "airConditioningOnBattery": {
              "title": "Air conditioning when not plugged in",
              "type": "string",
              "oneOf": [
                {
                  "title": "Keep the vehicle's setting",
                  "enum": ["vehicle"]
                },
                {
                  "title": "Allow (uses the drive battery)",
                  "enum": ["allow"]
                },
                {
                  "title": "Do not allow",
                  "enum": ["deny"]
                }
              ],
              "placeholder": "vehicle",
              "description": "For electric vehicles: whether the air conditioning may run from the drive battery when no charging cable is connected."
            },
            "auxiliaryHeatingDurationMinutes": {
              "title": "Auxiliary heating run time (minutes, optional)",
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "1-60. Leave empty to use the run time set in the vehicle."
            },
            "features": {
              "title": "Features",
              "type": "object",
              "properties": {
                "battery": {
                  "title": "Battery (electric and plug-in hybrid)",
                  "type": "boolean",
                  "default": true
                },
                "stateOfChargeSensor": {
                  "title": "State of charge as extra sensor, for automations",
                  "type": "boolean",
                  "default": false
                },
                "fuelLevel": {
                  "title": "Fuel level as battery (petrol, diesel, CNG, LPG)",
                  "type": "boolean",
                  "default": true
                },
                "fuelLevelSensor": {
                  "title": "Fuel level as extra sensor, for automations",
                  "type": "boolean",
                  "default": false
                },
                "charging": {
                  "title": "Start / stop charging (outlet)",
                  "type": "boolean",
                  "default": true
                },
                "chargingLimit": {
                  "title": "Charge limit (lightbulb brightness)",
                  "type": "boolean",
                  "default": true
                },
                "climate": {
                  "title": "Air conditioning (heater cooler)",
                  "type": "boolean",
                  "default": true
                },
                "auxiliaryHeating": {
                  "title": "Auxiliary heating (switch, needs S-PIN)",
                  "type": "boolean",
                  "default": true
                },
                "activeVentilation": {
                  "title": "Ventilation (switch)",
                  "type": "boolean",
                  "default": false
                },
                "presence": {
                  "title": "\"Home\" sensor (needs home location)",
                  "type": "boolean",
                  "default": true
                },
                "doors": {
                  "title": "Doors",
                  "type": "boolean",
                  "default": true
                },
                "windows": {
                  "title": "Windows",
                  "type": "boolean",
                  "default": true
                },
                "trunk": {
                  "title": "Trunk",
                  "type": "boolean",
                  "default": true
                },
                "bonnet": {
                  "title": "Bonnet",
                  "type": "boolean",
                  "default": true
                },
                "sunroof": {
                  "title": "Sunroof",
                  "type": "boolean",
                  "default": true
                },
                "lock": {
                  "title": "Locked (sensor)",
                  "type": "boolean",
                  "default": true
                },
                "lights": {
                  "title": "Lights on (sensor)",
                  "type": "boolean",
                  "default": false
                },
                "windowHeating": {
                  "title": "Window heating on (sensor)",
                  "type": "boolean",
                  "default": false
                },
                "plugLock": {
                  "title": "Charging plug locked (sensor)",
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "vehicles",
      "type": "array",
      "orderable": false,
      "buttonText": "Add vehicle",
      "items": [
        {
          "type": "section",
          "items": [
            "vehicles[].name",
            "vehicles[].vin",
            {
              "key": "vehicles[].token",
              "type": "password"
            },
            {
              "type": "help",
              "helpvalue": "<p>The plugin detects what your vehicle supports and only creates those services in HomeKit, so you can keep the defaults below. Switches marked <em>sensor</em> or <em>for automations</em> are off by default. After the first update the Homebridge log lists everything your vehicle supports, including what is turned off.</p>"
            },
            {
              "type": "fieldset",
              "title": "Doors, windows and lock",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.doors",
                "vehicles[].features.windows",
                "vehicles[].features.trunk",
                "vehicles[].features.bonnet",
                "vehicles[].features.sunroof",
                "vehicles[].features.lock",
                "vehicles[].features.lights"
              ]
            },
            {
              "type": "fieldset",
              "title": "Battery and fuel",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.battery",
                "vehicles[].features.stateOfChargeSensor",
                "vehicles[].features.fuelLevel",
                "vehicles[].features.fuelLevelSensor",
                {
                  "key": "vehicles[].lowBatteryThreshold",
                  "type": "number"
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "Charging",
              "description": "Electric and plug-in hybrid vehicles.",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.charging",
                "vehicles[].features.chargingLimit",
                "vehicles[].features.plugLock"
              ]
            },
            {
              "type": "fieldset",
              "title": "Air conditioning and ventilation",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.climate",
                {
                  "key": "vehicles[].climateTemperature",
                  "type": "number"
                },
                "vehicles[].airConditioningOnBattery",
                "vehicles[].features.windowHeating",
                "vehicles[].features.activeVentilation"
              ]
            },
            {
              "type": "fieldset",
              "title": "Auxiliary heating",
              "description": "Vehicles with a fuel-operated auxiliary heater.",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.auxiliaryHeating",
                {
                  "key": "vehicles[].spin",
                  "type": "password"
                },
                {
                  "key": "vehicles[].auxiliaryHeatingDurationMinutes",
                  "type": "number"
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "Home location",
              "description": "Used for the \"Home\" occupancy sensor.",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.presence",
                {
                  "type": "flex",
                  "flex-flow": "row wrap",
                  "items": [
                    {
                      "key": "vehicles[].home.lat",
                      "type": "number"
                    },
                    {
                      "key": "vehicles[].home.lon",
                      "type": "number"
                    },
                    {
                      "key": "vehicles[].home.radiusMeters",
                      "type": "number"
                    }
                  ]
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "Updates",
              "description": "The default fits most setups.",
              "expandable": true,
              "expanded": false,
              "items": [
                {
                  "key": "vehicles[].pollingIntervalMinutes",
                  "type": "number"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
