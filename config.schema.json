{
  "pluginAlias": "Skoda",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "headerDisplay": "Škoda vehicles via the official **MyŠkoda Public API**. Create an API key in the MyŠkoda app under *Profile › Smart Home*. Not an official Škoda project.",
  "footerDisplay": "See the [README](https://github.com/thecloudseeker/homebridge-skoda#readme) for details on each feature.",
  "schema": {
    "type": "object",
    "properties": {
      "vehicles": {
        "title": "Vehicles",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "placeholder": "Enyaq",
              "description": "Name in HomeKit."
            },
            "vin": {
              "title": "VIN",
              "type": "string",
              "required": true,
              "minLength": 17,
              "maxLength": 17,
              "pattern": "^[A-HJ-NPR-Za-hj-npr-z0-9]{17}$",
              "description": "17 characters."
            },
            "token": {
              "title": "API key",
              "type": "string",
              "required": true,
              "description": "From the MyŠkoda app, Profile › Smart Home."
            },
            "spin": {
              "title": "S-PIN (optional)",
              "type": "string",
              "description": "Only for the auxiliary heating. Never logged."
            },
            "home": {
              "title": "Home location",
              "type": "object",
              "properties": {
                "lat": {
                  "title": "Latitude",
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90,
                  "description": "e.g. 50.4128"
                },
                "lon": {
                  "title": "Longitude",
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180,
                  "description": "e.g. 14.9069"
                },
                "radiusMeters": {
                  "title": "Radius (m)",
                  "type": "integer",
                  "minimum": 10,
                  "placeholder": 150,
                  "description": "Default 150."
                }
              }
            },
            "pollingIntervalMinutes": {
              "title": "Update interval (minutes)",
              "type": "integer",
              "minimum": 4,
              "maximum": 1440,
              "placeholder": 5,
              "description": "Minimum 4, default 5. The API allows 20 requests per hour."
            },
            "lowBatteryThreshold": {
              "title": "Low battery / fuel warning below (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "placeholder": 20,
              "description": "Default 20."
            },
            "climateTemperature": {
              "title": "Default temperature (°C)",
              "type": "number",
              "minimum": 16,
              "maximum": 29.5,
              "multipleOf": 0.5,
              "placeholder": 21,
              "description": "Until the vehicle reports its own. 16–29.5, default 21."
            },
            "airConditioningOnBattery": {
              "title": "Air conditioning when not plugged in",
              "type": "string",
              "oneOf": [
                {
                  "title": "Keep the vehicle's setting",
                  "enum": ["vehicle"]
                },
                {
                  "title": "Allow (uses the drive battery)",
                  "enum": ["allow"]
                },
                {
                  "title": "Do not allow",
                  "enum": ["deny"]
                }
              ],
              "placeholder": "vehicle",
              "description": "Electric vehicles: run the air conditioning from the drive battery."
            },
            "auxiliaryHeatingDurationMinutes": {
              "title": "Auxiliary heating run time (minutes, optional)",
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "1–60. Empty uses the vehicle setting."
            },
            "features": {
              "title": "Features",
              "type": "object",
              "properties": {
                "battery": {
                  "title": "Battery (electric and plug-in hybrid)",
                  "type": "boolean",
                  "default": true,
                  "description": "Level, charging state, low warning."
                },
                "stateOfChargeSensor": {
                  "title": "State of charge as extra sensor, for automations",
                  "type": "boolean",
                  "default": false,
                  "description": "Humidity sensor in %. Counts as the room's humidity."
                },
                "fuelLevel": {
                  "title": "Fuel level as battery (petrol, diesel, CNG, LPG)",
                  "type": "boolean",
                  "default": true,
                  "description": "Shown as a battery, as HomeKit has no fuel service."
                },
                "fuelLevelSensor": {
                  "title": "Fuel level as extra sensor, for automations",
                  "type": "boolean",
                  "default": false,
                  "description": "Humidity sensor in %. Counts as the room's humidity."
                },
                "charging": {
                  "title": "Start / stop charging (outlet)",
                  "type": "boolean",
                  "default": true,
                  "description": "Outlet: on starts, off stops charging."
                },
                "chargingLimit": {
                  "title": "Charge limit (lightbulb brightness)",
                  "type": "boolean",
                  "default": true,
                  "description": "Brightness = limit, 50–100 %."
                },
                "climate": {
                  "title": "Air conditioning (heater cooler)",
                  "type": "boolean",
                  "default": true,
                  "description": "Start and stop at the target temperature."
                },
                "auxiliaryHeating": {
                  "title": "Auxiliary heating (switch, needs S-PIN)",
                  "type": "boolean",
                  "default": true,
                  "description": "Start and stop. Needs the S-PIN."
                },
                "activeVentilation": {
                  "title": "Ventilation (switch)",
                  "type": "boolean",
                  "default": false,
                  "description": "Start and stop the ventilation."
                },
                "presence": {
                  "title": "\"Home\" sensor (needs home location)",
                  "type": "boolean",
                  "default": true,
                  "description": "Detected while parked at home. Counts as presence in the room."
                },
                "doors": {
                  "title": "Doors",
                  "type": "boolean",
                  "default": true,
                  "description": "Open while a door is open."
                },
                "windows": {
                  "title": "Windows",
                  "type": "boolean",
                  "default": true,
                  "description": "Open while a window is open."
                },
                "trunk": {
                  "title": "Trunk",
                  "type": "boolean",
                  "default": true,
                  "description": "Open while the trunk is open."
                },
                "bonnet": {
                  "title": "Bonnet",
                  "type": "boolean",
                  "default": true,
                  "description": "Open while the bonnet is open."
                },
                "sunroof": {
                  "title": "Sunroof",
                  "type": "boolean",
                  "default": true,
                  "description": "Open while the sunroof is open."
                },
                "lock": {
                  "title": "Locked (lock, read-only)",
                  "type": "boolean",
                  "default": true,
                  "description": "Locked or unlocked. Cannot lock or unlock."
                },
                "lights": {
                  "title": "Lights on (sensor)",
                  "type": "boolean",
                  "default": false,
                  "description": "Open while the lights are on."
                },
                "windowHeating": {
                  "title": "Window heating on (sensor)",
                  "type": "boolean",
                  "default": false,
                  "description": "Open while on. Read-only."
                },
                "plugLock": {
                  "title": "Charging plug locked (sensor)",
                  "type": "boolean",
                  "default": false,
                  "description": "Open while a plugged-in cable is unlocked."
                },
                "pluggedIn": {
                  "title": "Plugged in (sensor, for automations)",
                  "type": "boolean",
                  "default": false,
                  "description": "Detected while the cable is plugged in. Counts as presence in the room."
                }
              }
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "vehicles",
      "type": "array",
      "orderable": false,
      "buttonText": "Add vehicle",
      "items": [
        {
          "type": "section",
          "items": [
            "vehicles[].name",
            "vehicles[].vin",
            {
              "key": "vehicles[].token",
              "type": "password"
            },
            {
              "type": "help",
              "helpvalue": "<p>Only services your vehicle supports are created, so the defaults are fine. The log lists what your vehicle supports.</p>"
            },
            {
              "type": "fieldset",
              "title": "Doors, windows and lock",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.doors",
                "vehicles[].features.windows",
                "vehicles[].features.trunk",
                "vehicles[].features.bonnet",
                "vehicles[].features.sunroof",
                "vehicles[].features.lock",
                "vehicles[].features.lights"
              ],
              "description": "Read-only sensors."
            },
            {
              "type": "fieldset",
              "title": "Battery and fuel",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.battery",
                "vehicles[].features.stateOfChargeSensor",
                "vehicles[].features.fuelLevel",
                "vehicles[].features.fuelLevelSensor",
                {
                  "key": "vehicles[].lowBatteryThreshold",
                  "type": "number"
                }
              ],
              "description": "Battery for electric vehicles, fuel level for combustion engines."
            },
            {
              "type": "fieldset",
              "title": "Charging",
              "description": "Electric and plug-in hybrid vehicles.",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.charging",
                "vehicles[].features.chargingLimit",
                "vehicles[].features.pluggedIn",
                "vehicles[].features.plugLock"
              ]
            },
            {
              "type": "fieldset",
              "title": "Air conditioning and ventilation",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.climate",
                {
                  "key": "vehicles[].climateTemperature",
                  "type": "number"
                },
                "vehicles[].airConditioningOnBattery",
                "vehicles[].features.windowHeating",
                "vehicles[].features.activeVentilation"
              ],
              "description": "Remote climate control."
            },
            {
              "type": "fieldset",
              "title": "Auxiliary heating",
              "description": "Vehicles with a fuel-operated heater.",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.auxiliaryHeating",
                {
                  "key": "vehicles[].spin",
                  "type": "password"
                },
                {
                  "key": "vehicles[].auxiliaryHeatingDurationMinutes",
                  "type": "number"
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "Home location",
              "description": "For the \"Home\" sensor.",
              "expandable": true,
              "expanded": false,
              "items": [
                "vehicles[].features.presence",
                {
                  "type": "flex",
                  "flex-flow": "row wrap",
                  "items": [
                    {
                      "key": "vehicles[].home.lat",
                      "type": "number"
                    },
                    {
                      "key": "vehicles[].home.lon",
                      "type": "number"
                    },
                    {
                      "key": "vehicles[].home.radiusMeters",
                      "type": "number"
                    }
                  ]
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "Updates",
              "description": "The default fits most setups.",
              "expandable": true,
              "expanded": false,
              "items": [
                {
                  "key": "vehicles[].pollingIntervalMinutes",
                  "type": "number"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
